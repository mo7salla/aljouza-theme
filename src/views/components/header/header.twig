{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

<header class="store-header">
  {# 1. Top Nav (مخصص فقط للروابط الهامة أو الفروع) #}
  {% if important_links or store.scope %}
  <div class="top-navbar bg-gray-50 py-1">
    <div class="container flex justify-between items-center text-xs">
      <div class="flex items-center gap-4">
          {% if important_links %}
            <salla-menu source="footer" topnav></salla-menu>
          {% endif %}

          {% if store.scope %}
              <button class="flex items-center gap-1 text-gray-500 hover:text-primary"
                      onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
                  <i class="sicon-location"></i> {{ store.scope.name }}
              </button>
          {% endif %}
      </div>
    </div>
  </div>
  {% endif %}

  {# 2. Main Nav (التوزيع الجديد: يمين - وسط - يسار) #}
  <div id="mainnav" class="main-nav-container bg-white flex items-center overflow-visible">
      <div class="inner w-full py-2">
          <div class="container">
              <div class="flex items-center justify-between relative w-full">
                  
                  {# الجزء الأيمن: الشعار #}
                  <div class="flex items-center lg:w-1/4">
                      <a class="lg:hidden mburger mburger--collapse leading-none rtl:ml-4 ltr:mr-4" href="#mobile-menu" aria-label="Open-menu">
                        <i class="sicon-menu text-primary text-2xl"></i>
                      </a>
                      <a class="navbar-brand" href="{{ store.url }}">
                          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
                          {% if is_page('index') %}
                            <h1 class="sr-only">{{ store.name }}</h1>
                          {% else %}
                            <h2 class="sr-only">{{ store.name }}</h2>
                          {% endif %}
                      </a>
                  </div>

                  {# الجزء الأوسط: الروابط تتوسط القائمة #}
                  <div class="hidden lg:flex flex-1 justify-center">
                      <custom-main-menu></custom-main-menu>
                  </div>

                  {# الجزء الأيسر: الأيقونات (بحث - مستخدم - سلة - لغة) #}
                  <div class="flex items-center justify-end lg:w-1/4 gap-4">
                      
                      {# أيقونة البحث (فقط أيقونة بدون صندوق) #}
                      <div class="header-search">
                        <salla-search mode="modal" height="40"></salla-search>
                      </div>

                      {# أيقونة حساب المستخدم #}
                      <salla-user-menu avatar-only show-trigger></salla-user-menu>
                      
                      {# أيقونة سلة المشتريات (بدون حدود برمجية) #}
                      <salla-cart-summary>
                        <i slot="icon" class="header-btn__icon sicon-shopping-bag text-xl"></i>
                      </salla-cart-summary>

                      {# تبديل اللغة والعملة (أصبح في أقصى اليسار) #}
                      <div class="header-localization border-r rtl:pr-4 ltr:pl-4 border-gray-100">
                          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
                              <salla-localization-modal show-trigger></salla-localization-modal>
                          {% endif %}
                      </div>
                      
                  </div>

              </div>
          </div>
      </div>
  </div>
</header>