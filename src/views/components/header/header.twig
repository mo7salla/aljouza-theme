{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

<header class="store-header">
  {# Top Nav #}
  <div class="top-navbar">
    <div class="flex justify-around items-center container">
      <div class="flex write">
        {# Language & Currency Component #}
        <div class="header-buttons">
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <salla-localization-modal show-trigger></salla-localization-modal>
          {% endif %}
        </div>

        {# Search bar #}
        <button onclick="salla.event.dispatch('search::open')" class="btn--circle-gray search-btn">
          <span class="sicon-search"></span>
        </button>

        {# Scopes | Branches #}
        {% if store.scope %}
          <button class="btn--rounded-gray" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
            <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
          </button>
        {% endif %}
      </div>

      <div class="flex center">
        {# logo #}
        <a class="navbar-brand" href="{{ store.url }}">
          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
          {% if is_page('index') %}
            <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
            <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>
      </div>

      <div class="flex left">
        <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
        <salla-cart-summary class="ml-4 rtl:ml-[unset] rtl:mr-4">
          <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
        </salla-cart-summary>
      </div>
    </div>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container flex items-center bg-white shadow-sm">
    <div class="inner w-full container mx-auto px-4">
        <div class="flex justify-between items-center">
            
         
            <div class="flex items-center gap-3 order-last lg:order-first">
                <a class="lg:hidden mburger mburger--collapse p-2 hover:bg-gray-100 rounded-lg transition-colors" 
                   href="#mobile-menu" 
                   aria-label="Open-menu">
                    <i class="sicon-menu text-primary text-2xl"></i>
                </a>
                <custom-main-menu></custom-main-menu>
            </div>
            
          
            <div class="absolute left-1/2 transform -translate-x-1/2 lg:relative lg:left-auto lg:transform-none">
                {% if store.logo %}
                    <img src="{{ store.logo }}" alt="{{ store.name }}" class="h-8 w-auto">
                {% else %}
                    <span class="font-bold text-gray-800">{{ store.name }}</span>
                {% endif %}
            </div>
            
            
            <div class="flex items-center gap-3">
                <salla-cart-summary>
                    <i slot="icon" class="sicon-shopping-bag text-xl"></i>
                </salla-cart-summary>
            </div>
            
        </div>
    </div>
</div>
</header>
