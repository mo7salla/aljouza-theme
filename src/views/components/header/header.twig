{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

<header class="store-header">

  {# ===== الصف العلوي: اللغة/العملة | الشعار | البحث ===== #}
  <div class="top-navbar">
    <div class="flex justify-between items-center inner">
      {# Language & Currency Component #}
      <div class="left">
        <div class="header-buttons">
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <salla-localization-modal show-trigger></salla-localization-modal>
          {% endif %}
      </div>

      {# Logo #}
      <div class="center">
        <a href="{{ store.url }}" class="logo">
          {% if store.settings.logo %}
            <img src="{{ store.settings.logo | img_url('200x') }}" alt="{{ store.name }}">
          {% else %}
            {{ store.name }}
          {% endif %}
        </a>
      </div>

      {# Search Component #}
      <div class="write">
        <button onclick="salla.event.dispatch('search::open')" class="btn--circle-gray search-btn">
          <span class="sicon-search"></span>
        </button>
      </div>
    </div>

  </div>

 

</header>