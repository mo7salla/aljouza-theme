{#
| Variable         | Type    | Description                     |
|------------------|---------|---------------------------------|
| cart             | object  |                                 |
| cart.items_count | int     |                                 |
| cart.total       | string  | Formatted total ex: "١٠٠ ر.س"   |
#}
{% set important_links = theme.settings.get('important_links') %}

<header class="store-header">
  {# Top Nav #}
  <div class="top-navbar bg-primary text-white w-xl m-auto">
    <div class="container flex justify-between">
      {# Language & Currency and Scopes | Branches #}
      <div class="left">
        <div class="header-buttons">
          {% if store.settings.is_multilingual or store.settings.currencies_enabled %}
            <salla-localization-modal show-trigger></salla-localization-modal>
          {% endif %}
        </div>

        {# Scopes | Branches #}
        {% if store.scope %}
          <button class="btn--rounded-gray" onclick="salla.event.dispatch('scopes::open', {'mode': 'default'})">
            <i class="sicon-location rtl:ml-1 ltr:mr-1"></i> {{ store.scope.name }}
          </button>
        {% endif %}
      </div>

      {# Logo #}
      <div class="center">
        <a class="navbar-brand" href="{{ store.url }}">
          <img fetchpriority="high" width="100%" height="100%" loading="eager" src="{{ store.logo|cdn(175) }}" alt="{{ store.name }} logo">
          {% if is_page('index') %}
            <h1 class="sr-only">{{ store.name }}</h1>
          {% else %}
            <h2 class="sr-only">{{ store.name }}</h2>
          {% endif %}
        </a>
      </div>

      {# Search #}
      <div class="write">
        <button onclick="salla.event.dispatch('search::open')" class="btn--circle-gray search-btn">
          <span class="sicon-search"></span>
        </button>
      </div>
    </div>
  </div>

  {# Main Nav #}
  <div id="mainnav" class="main-nav-container flex items-center mb-4">
    <div class="container">
      <div class="inner w-full bg-primary/90 dark:bg-dark/90 backdrop-blur-lg rounded-b-[2rem] shadow-lg border border-white/20 dark:border-gray-800/50 px-4 lg:px-8 text-white">
        <div class="flex items-stretch justify-between relative">
          <div class="flex items-center">
            <a class="lg:hidden mburger mburger--collapse leading-none rtl:ml-4 ltr:mr-4" href="#mobile-menu" aria-label="Open-menu">
              <i class="sicon-menu text-white text-2xl"></i>
            </a>
            <custom-main-menu></custom-main-menu>
          </div>

          <div class="flex items-center justify-end my-2.5">
            <salla-user-menu avatar-only show-header show-trigger></salla-user-menu>
            <salla-cart-summary class="ml-4 rtl:ml-[unset] rtl:mr-4">
              <i slot="icon" class="header-btn__icon icon sicon-shopping-bag"></i>
            </salla-cart-summary>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>