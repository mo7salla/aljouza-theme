<section class="s-block s-block--testimonials container overflow-hidden py-10 relative animate-on-scroll">
	
	{# Decorative Background Arrows #}
	<div class="absolute top-1/2 rtl:right-0 ltr:left-0 -translate-y-1/2 hidden lg:flex opacity-[0.03] pointer-events-none z-0">
		<i class="sicon-keyboard_arrow_right text-[15rem] text-primary"></i>
	</div>
	<div class="absolute top-1/2 rtl:left-0 ltr:right-0 -translate-y-1/2 hidden lg:flex opacity-[0.03] pointer-events-none z-0">
		<i class="sicon-keyboard_arrow_left text-[15rem] text-primary"></i>
	</div>

	<div class="relative z-10">
		{# Header & Description #}
		<div class="text-center mb-12">
			<h1 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-3">{{ trans('blocks.home.testimonials') }}</h1>
			<p class="text-gray-500 text-sm md:text-base max-w-lg mx-auto mb-6">نفخر بخدمتكم ونسعد بسماع تجاربكم الرائعة معنا دائماً.</p>
			
			{# Decorative Pagination Dots #}
			<div class="flex justify-center gap-2">
				<span class="w-8 h-2 rounded-full bg-primary/20"></span>
				<span class="w-2 h-2 rounded-full bg-primary"></span>
				<span class="w-2 h-2 rounded-full bg-primary/20"></span>
			</div>
		</div>

		{# Desktop View: Centered Slider #}
		<div class="hidden lg:block">
			<salla-slider id="custom-testimonials-{{ position }}-slider" 
										centered slides-per-view="3" 
										type="testimonials" 
										class="testimonials-slider-apple" 
										auto-play 
										controls-outer>
				<div slot="items">
					{% for index, item in component.items %}
					<div class="swiper-slide px-2 py-8 transition-all duration-500 ease-out">
						<div class="testimonial-card-desktop flex bg-white dark:bg-gray-800 rounded-[14px] shadow-apple p-6 items-center border border-gray-100/50 h-full">
							<div class="shrink-0 rtl:ml-6 ltr:mr-6">
								<img src="{{ item.avatar }}" alt="{{ item.name }}" class="w-24 h-24 object-cover rounded-[14px] shadow-sm">
							</div>
							<div class="flex-1 text-start">
								<h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">{{ item.name }}</h3>
								<p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3 mb-3 leading-relaxed">"{{ item.text }}"</p>
								<div class="flex flex-col gap-1 mt-auto">
									<salla-rating-stars size="small" value="{{ item.stars }}"></salla-rating-stars>
									<span class="text-[10px] text-gray-400 font-medium">تجربة عميل موثقة</span>
								</div>
							</div>
						</div>
					</div>
					{% endfor %}
				</div>
			</salla-slider>
		</div>

		{# Mobile View: iOS Notification Stacking #}
		<div class="ios-stack-wrapper relative block lg:hidden w-full max-w-[90%] mx-auto h-[260px] mt-8">
			{% for index, item in component.items|slice(0, 3) %}
				<div class="ios-stack-card absolute w-full rounded-[14px] shadow-apple bg-white dark:bg-gray-800 p-5 flex items-center border border-gray-100/80 transition-all duration-500 ease-out"
						 style="z-index: {{ 10 - index }}; top: {{ index * 22 }}px; transform: scale({{ 1 - (index * 0.06) }}); opacity: {{ 1 - (index * 0.25) }};">
					<div class="shrink-0 rtl:ml-4 ltr:mr-4">
						<img src="{{ item.avatar }}" alt="{{ item.name }}" class="w-20 h-20 object-cover rounded-[12px] shadow-sm">
					</div>
					<div class="flex-1 text-start">
						<h3 class="text-base font-bold text-gray-900 dark:text-white mb-1">{{ item.name }}</h3>
						<p class="text-xs text-gray-600 dark:text-gray-300 line-clamp-2 leading-relaxed mb-2">"{{ item.text }}"</p>
						<div class="flex flex-col gap-1">
							<salla-rating-stars size="small" value="{{ item.stars }}"></salla-rating-stars>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>

	</div>
</section>
